{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    // TS 6 defaults `strict` to true; this codebase was never strict.
    "strict": false,
    "paths": {
      "app/*": ["./src/app/*"],
      "environments/*": ["./src/environments/*"]
    },
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "module": "esnext",
    "useDefineForClassFields": false
  }
}

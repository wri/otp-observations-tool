{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "",
    "types": [],
    "paths": {
      // @michalkotas/angular2-jsonapi declares only lodash-es as a dependency, but one of its
      // modules still does `import { ... } from 'lodash'`, which drags the whole 70kB monolithic
      // CommonJS build in (worth ~55kB of main.js). lodash-es exposes the same functions as ES
      // modules, so webpack can tree-shake down to the handful actually used.
      // Only the bare specifier is remapped; deep `lodash/foo` imports resolve as before.
      "lodash": ["../node_modules/lodash-es"]
    }
  },
  // Angular 9 warns about files that are in the compilation but not reachable from an entry
  // point (the environment.*.ts variants are only pulled in via fileReplacements). Listing the
  // real entry points instead of excluding by pattern silences that and narrows the compilation.
  // The web worker deliberately stays out of this compilation - it has its own
  // tsconfig.worker.json with the webworker lib, which conflicts with lib.dom here.
  "files": [
    "main.ts",
    "polyfills.ts"
  ],
  "include": [
    "**/*.d.ts"
  ],
  "exclude": [
    "**/*.worker.ts"
  ]
}

{
  "name": "otp-observations-tool",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "postinstall": "patch-package",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "dev": "ng serve --configuration=local",
    "build": "ng build",
    "lint": "ng lint",
    "prod-build": "ng build --output-path=build/ --base-href=/observations-tool/ --configuration=production",
    "staging-build": "ng build --output-path=build/ --base-href=/observations-tool/ --configuration=staging",
    "bundle-stats": "ng build --configuration=production --stats-json --output-path=dist/",
    "bundle-report": "yarn bundle-stats && webpack-bundle-analyzer dist/stats.json",
    "transifex:push": "env $(grep ^TX_TOKEN -m 1 .env | xargs) tx push -s",
    "transifex:pull": "env $(grep ^TX_TOKEN -m 1 .env | xargs) tx pull -a -f && node transifex/format-locales.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "@bluehalo/ngx-leaflet": "^19",
    "@hotjar/browser": "1.0.5",
    "@michalkotas/angular2-jsonapi": "18.0.1",
    "@ngx-translate/core": "^15",
    "@ngx-translate/http-loader": "^8",
    "@sentry/browser": "^7",
    "@sentry/integrations": "^7",
    "@types/leaflet": "~1.9.0",
    "a11y-dialog": "^4.0.1",
    "date-fns": "1",
    "exif-js": "^2.3.0",
    "express": "^4.15.2",
    "flatpickr": "~4.6.13",
    "foundation-sites": "6.8.1",
    "leaflet": "~1.9.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.15",
    "ngx-bootstrap-multiselect": "4.0.0",
    "proj4": "^2.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^6.6.7",
    "tslib": "2.3.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.27",
    "@angular-devkit/core": "19.2.27",
    "@angular-eslint/builder": "19.8.1",
    "@angular/cli": "19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "@eslint/js": "^9.28.0",
    "@sentry/cli": "^2.21.5",
    "@types/node": "^24",
    "angular-eslint": "19.8.1",
    "dotenv": "^4.0.0",
    "eslint": "^9.28.0",
    "node-fetch": "^1.7.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "ts-node": "~2.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "webpack-bundle-analyzer": "^2.8.1"
  },
  "resolutions": {
    "browserslist": "4.24.0",
    "node-releases": "2.0.44"
  }
}

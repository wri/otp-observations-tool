{
  "name": "otp-observations-tool",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "postinstall": "patch-package",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "dev": "ng serve --configuration=local",
    "build": "ng build",
    "lint": "tslint -c tslint.json -p src/tsconfig.app.json && tslint -c tslint.json -p src/tsconfig.spec.json && tslint -c tslint.json -p tsconfig.worker.json",
    "prod-build": "ng build --output-path=build/ --base-href=/observations-tool/ --configuration=production",
    "staging-build": "ng build --output-path=build/ --base-href=/observations-tool/ --configuration=staging",
    "bundle-stats": "ng build --configuration=production --stats-json --output-path=dist/",
    "bundle-report": "yarn bundle-stats && webpack-bundle-analyzer dist/stats.json",
    "transifex:push": "env $(grep ^TX_TOKEN -m 1 .env | xargs) tx push -s",
    "transifex:pull": "env $(grep ^TX_TOKEN -m 1 .env | xargs) tx pull -a -f && node transifex/format-locales.js"
  },
  "private": true,
  "dependencies": {
    "@abraham/reflection": "^0.12.0",
    "@angular/common": "16.2.12",
    "@angular/compiler": "16.2.12",
    "@angular/core": "16.2.12",
    "@angular/forms": "16.2.12",
    "@angular/platform-browser": "16.2.12",
    "@angular/platform-browser-dynamic": "16.2.12",
    "@angular/router": "16.2.12",
    "@asymmetrik/ngx-leaflet": "^16",
    "@hotjar/browser": "1.0.5",
    "@michalkotas/angular2-jsonapi": "16.0.0",
    "@ngx-translate/core": "14.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "@sentry/browser": "^7",
    "@sentry/integrations": "^7",
    "@types/leaflet": "~1.9.0",
    "a11y-dialog": "^4.0.1",
    "date-fns": "1",
    "exif-js": "^2.3.0",
    "express": "^4.15.2",
    "flatpickr": "~4.6.13",
    "foundation-sites": "6.8.1",
    "leaflet": "~1.9.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.15",
    "ngx-bootstrap-multiselect": "4.0.0",
    "proj4": "^2.6.1",
    "rxjs": "^6.6.7",
    "tslib": "2.3.1",
    "zone.js": "0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "16.2.16",
    "@angular-devkit/core": "16.2.16",
    "@angular/cli": "16.2.16",
    "@angular/compiler-cli": "16.2.12",
    "@sentry/cli": "^2.21.5",
    "@types/node": "~6.0.60",
    "codelyzer": "6.0.2",
    "dotenv": "^4.0.0",
    "node-fetch": "^1.7.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "ts-node": "~2.0.0",
    "tslint": "^6.1.3",
    "typescript": "4.9.5",
    "webpack-bundle-analyzer": "^2.8.1"
  },
  "resolutions": {
    "browserslist": "4.24.0",
    "node-releases": "2.0.44"
  }
}

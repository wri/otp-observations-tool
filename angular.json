{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "otp-observations-tool": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": "src/polyfills.ts",
            "assets": [
              "src/assets",
              "src/favicon.ico",
              "src/manifest.json",
              "src/android-chrome-192x192.png",
              "src/android-chrome-512x512.png",
              "src/apple-touch-icon.png",
              "src/favicon-16x16.png",
              "src/favicon-32x32.png",
              "src/mstile-150x150.png",
              "src/safari-pinned-tab.svg",
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "/assets"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/leaflet/dist/leaflet.css"
            ],
            "scripts": [],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "allowedCommonJsDependencies": [
              "lodash/cloneDeep",
              "lodash/debounce",
              "lodash/flatten",
              "lodash/orderBy",
              "lodash/sortBy",
              "lodash/truncate",
              "lodash/uniq",
              "lodash/uniqBy",
              "exif-js",
              "proj4",
              "angular2-spinner/dist",
              "a11y-dialog",
              "date-fns/format",
              "date-fns/parse",
              "qs",
              "rxjs/Subject",
              "rxjs/add/operator/takeUntil",
              "rxjs/add/observable/of",
              "rxjs/add/operator/concat",
              "rxjs/add/operator/map",
              "rxjs/add/operator/merge",
              "rxjs/add/operator/share",
              "rxjs/add/operator/switchMap",
              "rxjs/add/operator/take",
              "rxjs/add/operator/toArray"
            ]
          },
          "configurations": {
            "e2e": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                }
              ]
            },
            "local": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local.ts"
                }
              ]
            },
            "staging": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.staging.ts"
                }
              ]
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.2mb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "otp-observations-tool:build"
          },
          "configurations": {
            "e2e": {
              "browserTarget": "otp-observations-tool:build:e2e"
            },
            "local": {
              "browserTarget": "otp-observations-tool:build:local"
            },
            "staging": {
              "browserTarget": "otp-observations-tool:build:staging"
            },
            "production": {
              "browserTarget": "otp-observations-tool:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "otp-observations-tool:build"
          }
        }
      }
    }
  },
  "defaultProject": "otp-observations-tool",
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "otp",
      "styleext": "scss"
    },
    "@schematics/angular:directive": {
      "prefix": "otp"
    }
  },
  "cli": {
    "packageManager": "yarn"
  }
}
